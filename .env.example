# Copy this file to ".env" and fill in real values before starting the server.

# MongoDB connection string (local mongod or a hosted cluster e.g. MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/facebook-prototype

# Port the Nest/Express server listens on
PORT=5000

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET=super_secret_dev_key_change_me
JWT_EXPIRES_IN=7d

# Only needed if Node cannot do raw DNS SRV lookups on this network (fixes
# "querySrv ECONNREFUSED" with mongodb+srv:// URIs). Comma separated.
DNS_SERVERS=1.1.1.1,8.8.8.8

# Comma separated list of allowed frontend origins (for CORS)
CLIENT_URL=http://localhost:5173

# Used by "npm run seed" to create the first admin account + demo data
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Show the password-reset code on the Forgot password screen (there is no
# email server). Defaults to on outside production; set true on Render to
# enable it there. Admin accounts never get their code shown.
SHOW_RESET_CODE=true
# The code shown while SHOW_RESET_CODE is on (6 digits, default 123456).
DEMO_RESET_CODE=123456
